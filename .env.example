# QuantDesk backend settings (all app-owned; no third-party credentials are used anywhere).
# Leave DATABASE_URL unset (or set it to a sqlite URL) to use the zero-setup SQLite file backend/quantdesk.db.
DATABASE_URL=postgresql+psycopg://quantdesk:quantdesk@localhost:5432/quantdesk
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random development key is generated at startup (tokens then reset on restart).
SECRET_KEY=change-me
ENV=development
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006
# Defaults to <repo>/datasets (CSV exports + sample dataset)
# LOCAL_DATA_DIRECTORY=/absolute/path/to/datasets
SIMULATOR_SEED=42
SIMULATOR_TICK_MS=1000
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30
